# Spring Boot does not auto-load .env files - export these as real environment variables
# (shell `export`, IDE run configuration, etc.) before running the app. This file exists to
# document what's required, per docs/07-tech-stack.md.

# Required. HS256 signing secret for issued JWTs - generate a long random value, at least
# 32 bytes, e.g.: openssl rand -base64 48
JWT_SECRET=

# Optional, defaults to 24h (86400000 ms) if unset.
JWT_EXPIRATION_MS=86400000

# "mock" (default, no API calls) or "chain" (real Groq -> OpenRouter -> Cloudflare fallback
# chain - see com.finme.backend.ai.AiProviderConfig). Deliberately defaults to mock even with
# real keys below present - flip it on deliberately, it spends real API quota.
AI_PROVIDER=mock

# --- Production AI fallback chain (docs/03-system-design.md Sec. 5) ---
# Each provider gets its own AiProvider implementation and its own dedicated key for this
# project (NFR-9) - never reuse a key from another project. Zero/minimum data retention must
# be enabled on each provider's dashboard before it's wired in, per NFR-3.
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Gemini: dev-only, non-financial content generation ONLY (NFR-4) ---
# Free tier trains on submitted content - this key must never be reachable from any code path
# that touches real transaction/balance/credit data. Keep its call site a separate class from
# the AiProvider chain above, not a config flag on the same one (see docs/06-risk-register.md
# R9). Placeholder only - not yet read by any code.
GEMINI_API_KEY=

# --- Google OAuth login ---
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web
# application). Authorized redirect URI must include http://localhost:8080/login/oauth2/code/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email verification + weekly digest (Brevo's free SMTP relay) ---
# Sign up free at brevo.com (no card required, 300 emails/day forever). SMTP_USERNAME/
# SMTP_PASSWORD come from Settings -> SMTP & API on Brevo's dashboard - SMTP_PASSWORD is the
# generated SMTP key, not your Brevo account password. MAIL_FROM_ADDRESS must be a sender
# verified in Brevo's dashboard (Senders, Domains & Dedicated IPs) - it can differ from
# SMTP_USERNAME, which is why it's a separate value.
# Previously Gmail SMTP + an App Password; before that, SendGrid, whose "free tier" is now gone
# entirely (May 2025), not just the 60-day trial originally documented here.
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
# Optional override - defaults to smtp-relay.brevo.com, no need to set this for Brevo.
# SMTP_HOST=
# Optional overrides - defaults shown are fine for local dev.
# BACKEND_BASE_URL=http://localhost:8080
# AUTH_FRONTEND_REDIRECT_URI=http://localhost:5173/auth-callback
# AUTH_FRONTEND_LOGIN_URI=http://localhost:5173/login
# EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Required in the prod profile only (application-prod.properties) - not used in dev (H2).
# DB_URL=
# DB_USERNAME=
# DB_PASSWORD=
# CORS_ALLOWED_ORIGINS=
